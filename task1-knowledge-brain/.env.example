# Claude is the core model. Without a key the brain still works in extractive (no-LLM) mode.
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5        # captions + query rewriting
# $ per million tokens, so cost shows up in /v1/stats and the evals. Check the pricing page.
PRICE_claude-sonnet-5-5=0,0
PRICE_claude-haiku-5-5=0,0
EMBEDDER=fastembed                  # fastembed | hash (offline fallback, used in tests)
BRAIN_API_KEY=                      # if set, clients must send X-API-Key
SYNC_HOUR_UTC=3                     # daily sync time
CRAWL_DELAY_S=1.0
CRAWL_CONCURRENCY=2
MIN_COSINE=0.5                      # below this the bot says "I don't know" and opens an expert task
